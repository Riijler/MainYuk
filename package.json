{
  "name": "penyewaan-lapangan",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi web penyewaan lapangan untuk ujian praktik SMK RPL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "css:build": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "mysql2": "$mysql2",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
