<%- include('../partials/header', { judul }) %>
<%- include('../partials/navbar') %>
<main id="konten" class="mx-auto w-full max-w-7xl flex-1 px-6 py-10">
  <p class="font-mono text-xs font-bold uppercase tracking-widest">ADMIN / AKUN</p>
  <div class="mt-2 flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-4xl font-black uppercase sm:text-5xl">Kelola pengguna</h1><p class="mt-3 text-neutral-700">Atur penyewa, petugas, dan administrator.</p></div><a href="/admin/user/baru" class="tombol-utama">Tambah pengguna <span aria-hidden="true" class="ml-2">+</span></a></div>
  <%- include('nav', { urlHalaman: '/admin/user' }) %>
  <% if (pesan) { %><p role="status" class="mb-5 border-2 border-tinta bg-lime p-3 font-semibold"><%= pesan %></p><% } %>
  <section class="overflow-x-auto border-2 border-tinta bg-kertas" role="region" tabindex="0" aria-label="Daftar pengguna yang dapat digeser ke samping">
    <p class="border-b border-tinta px-3 py-2 text-xs font-semibold sm:hidden">Geser tabel ke samping untuk melihat kolom lainnya.</p>
    <table class="w-full min-w-[760px] border-collapse text-left">
      <thead class="bg-tinta font-mono text-xs uppercase text-white"><tr><th class="p-3">Nama</th><th class="p-3">Username</th><th class="p-3">No. HP</th><th class="p-3">Role</th><th class="p-3">Aksi</th></tr></thead>
      <tbody>
        <% daftarUser.forEach((pengguna, indeks) => { %>
          <tr class="border-t-2 border-tinta <%= indeks % 2 ? 'bg-[#f3eee1]' : 'bg-kertas' %>">
            <td class="p-3 font-bold"><%= pengguna.nama %></td><td class="p-3 font-mono text-sm"><%= pengguna.username %></td><td class="p-3"><%= pengguna.no_hp %></td>
            <td class="p-3"><span class="border-2 border-tinta bg-lime px-2 py-1 font-mono text-[10px] font-bold uppercase"><%= pengguna.role %></span></td>
            <td class="p-3"><div class="flex gap-2"><a href="/admin/user/<%= pengguna.id %>/edit" class="border-2 border-tinta px-3 py-2 text-sm font-bold hover:bg-lime">Ubah</a><% if (pengguna.id !== sessionPenggunaId) { %><form action="/admin/user/<%= pengguna.id %>/hapus" method="post" onsubmit="return confirm('Hapus akun ini? Akun yang memiliki booking atau audit tidak dapat dihapus.');"><button class="border-2 border-tinta bg-white px-3 py-2 text-sm font-bold hover:bg-oranye">Hapus</button></form><% } %></div></td>
          </tr>
        <% }) %>
        <% if (!daftarUser.length) { %><tr><td colspan="5" class="p-5">Belum ada pengguna.</td></tr><% } %>
      </tbody>
    </table>
  </section>
</main>
<%- include('../partials/footer') %>
</body>
</html>
