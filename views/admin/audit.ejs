<%- include('../partials/header', { judul }) %>
<%- include('../partials/navbar') %>
<main id="konten" class="mx-auto w-full max-w-7xl flex-1 px-6 py-10">
  <p class="font-mono text-xs font-bold uppercase tracking-widest">ADMIN / CATATAN AKTIVITAS</p>
  <h1 class="mt-2 text-4xl font-black uppercase sm:text-5xl">Audit log</h1>
  <p class="mt-3 text-neutral-700">Aktivitas login, booking, pembayaran, pembatalan, dan ekspor.</p>
  <%- include('nav', { urlHalaman: '/admin/audit' }) %>
  <form action="/admin/audit" method="get" class="grid gap-3 border-2 border-tinta bg-kertas p-4 sm:grid-cols-[1fr_200px_140px_auto] sm:items-end">
    <div><label for="cari" class="label-form">Cari pengguna, aksi, atau kode booking</label><input id="cari" name="cari" class="input-form" value="<%= cari %>" maxlength="100"></div>
    <div><label for="urut" class="label-form">Urutkan</label><select id="urut" name="urut" class="input-form"><% const opsiUrut = [['waktu','Waktu'],['pengguna','Pengguna'],['aksi','Aksi'],['kode','Kode booking']]; opsiUrut.forEach(([nilai,label]) => { %><option value="<%= nilai %>" <%= urut === nilai ? 'selected' : '' %>><%= label %></option><% }) %></select></div>
    <div><label for="arah" class="label-form">Arah</label><select id="arah" name="arah" class="input-form"><option value="desc" <%= arah === 'desc' ? 'selected' : '' %>>Turun</option><option value="asc" <%= arah === 'asc' ? 'selected' : '' %>>Naik</option></select></div>
    <button class="tombol-utama">Cari</button>
  </form>
  <section class="mt-6 overflow-x-auto border-2 border-tinta bg-kertas" role="region" tabindex="0" aria-label="Daftar audit yang dapat digeser ke samping">
    <p class="border-b border-tinta px-3 py-2 text-xs font-semibold sm:hidden">Geser tabel ke samping untuk melihat kolom lainnya.</p>
    <table class="w-full min-w-[780px] border-collapse text-left">
      <thead class="bg-tinta font-mono text-xs uppercase text-white"><tr><th class="p-3">Waktu</th><th class="p-3">Pengguna</th><th class="p-3">Aksi</th><th class="p-3">Booking</th></tr></thead>
      <tbody><% daftarLog.forEach((log, indeks) => { %>
        <tr class="border-t-2 border-tinta <%= indeks % 2 ? 'bg-[#f3eee1]' : 'bg-kertas' %>">
          <td class="p-3 font-mono text-xs"><%= new Date(log.waktu).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
          <td class="p-3"><p class="font-bold"><%= log.pengguna_nama %></p><p class="font-mono text-xs"><%= log.username %></p></td>
          <td class="p-3"><span class="border-2 border-tinta bg-lime px-2 py-1 font-mono text-[10px] font-bold uppercase"><%= log.aksi %></span></td>
          <td class="p-3 font-mono text-xs"><%= log.kode_booking || '—' %></td>
        </tr>
      <% }) %><% if (!daftarLog.length) { %><tr><td colspan="4" class="p-6 text-center">Tidak ada catatan yang sesuai.</td></tr><% } %></tbody>
    </table>
  </section>
  <% if (jumlahHalaman > 1) { %><nav class="mt-6 flex justify-end gap-2" aria-label="Halaman audit"><% if (halaman > 1) { %><a href="/admin/audit?halaman=<%= halaman - 1 %>&cari=<%= encodeURIComponent(cari) %>&urut=<%= urut %>&arah=<%= arah %>" class="border-2 border-tinta bg-kertas px-4 py-2 font-bold">Sebelumnya</a><% } %><span class="border-2 border-tinta bg-lime px-4 py-2 font-mono text-sm font-bold"><%= halaman %> / <%= jumlahHalaman %></span><% if (halaman < jumlahHalaman) { %><a href="/admin/audit?halaman=<%= halaman + 1 %>&cari=<%= encodeURIComponent(cari) %>&urut=<%= urut %>&arah=<%= arah %>" class="border-2 border-tinta bg-kertas px-4 py-2 font-bold">Berikutnya</a><% } %></nav><% } %>
</main>
<%- include('../partials/footer') %>
</body>
</html>
