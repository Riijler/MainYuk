<%- include('../partials/header', { judul }) %>
<%- include('../partials/navbar') %>
<main id="konten" class="mx-auto w-full max-w-7xl flex-1 px-6 py-10">
  <p class="font-mono text-xs font-bold uppercase tracking-widest">ADMIN / KEUANGAN</p>
  <h1 class="mt-2 text-4xl font-black uppercase sm:text-5xl">Rekap pendapatan</h1>
  <p class="mt-3 text-neutral-700">Pendapatan dihitung dari booking berstatus dibayar atau selesai.</p>
  <%- include('nav', { urlHalaman: '/admin/rekap' }) %>
  <% if (pesanError) { %><p role="alert" class="mb-5 border-2 border-tinta bg-oranye p-3 font-semibold"><%= pesanError %></p><% } %>
  <form action="/admin/rekap" method="get" class="grid gap-4 border-2 border-tinta bg-kertas p-5 shadow-keras sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.2fr_auto] lg:items-end">
    <div><label for="mulai" class="label-form">Dari tanggal</label><input id="mulai" name="mulai" type="date" class="input-form" value="<%= tanggalMulai %>" required></div>
    <div><label for="selesai" class="label-form">Sampai tanggal</label><input id="selesai" name="selesai" type="date" class="input-form" value="<%= tanggalSelesai %>" required></div>
    <div><label for="lapangan" class="label-form">Lapangan</label><select id="lapangan" name="lapangan" class="input-form"><option value="">Semua lapangan</option><% daftarLapangan.forEach((lapangan) => { %><option value="<%= lapangan.id %>" <%= Number(lapanganId) === lapangan.id ? 'selected' : '' %>><%= lapangan.nama %></option><% }) %></select></div>
    <button class="tombol-utama">Tampilkan rekap</button>
  </form>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <article class="border-2 border-tinta bg-kertas p-5 shadow-keras"><p class="font-mono text-xs font-bold uppercase">BOOKING DIBAYAR / SELESAI</p><p class="mt-2 text-3xl font-black"><%= jumlahBooking %></p></article>
    <article class="border-2 border-tinta bg-lime p-5 shadow-keras"><p class="font-mono text-xs font-bold uppercase">TOTAL PENDAPATAN</p><p class="mt-2 text-3xl font-black">Rp<%= totalFormat %></p></article>
  </div>
  <div class="mt-7 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-xl font-black uppercase">Rincian booking</h2>
    <a href="/admin/rekap/ekspor?mulai=<%= encodeURIComponent(tanggalMulai) %>&selesai=<%= encodeURIComponent(tanggalSelesai) %>&lapangan=<%= lapanganId || '' %>" class="border-2 border-tinta bg-kertas px-4 py-2 font-bold shadow-keras hover:bg-lime">Unduh Excel <span aria-hidden="true">↗</span></a>
  </div>
  <section class="mt-4 overflow-x-auto border-2 border-tinta bg-kertas" role="region" tabindex="0" aria-label="Rincian rekap yang dapat digeser ke samping">
    <p class="border-b border-tinta px-3 py-2 text-xs font-semibold sm:hidden">Geser tabel ke samping untuk melihat kolom lainnya.</p>
    <table class="w-full min-w-[850px] border-collapse text-left">
      <thead class="bg-tinta font-mono text-xs uppercase text-white"><tr><th class="p-3">Kode</th><th class="p-3">Tanggal</th><th class="p-3">Penyewa</th><th class="p-3">Lapangan / jam</th><th class="p-3">Status</th><th class="p-3">Total</th></tr></thead>
      <tbody><% daftar.forEach((booking, indeks) => { %>
        <tr class="border-t-2 border-tinta <%= indeks % 2 ? 'bg-[#f3eee1]' : 'bg-kertas' %>">
          <td class="p-3 font-mono text-xs font-bold"><%= booking.kode_booking %></td>
          <td class="p-3"><%= new Date(`${booking.tanggal}T00:00:00Z`).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %></td>
          <td class="p-3"><%= booking.penyewa_nama %></td>
          <td class="p-3"><p class="font-bold"><%= booking.lapangan_nama %></p><p class="font-mono text-xs"><%= String(booking.jam_mulai).slice(0, 5) %>—<%= String(booking.jam_selesai).slice(0, 5) %></p></td>
          <td class="p-3 font-mono text-xs font-bold uppercase"><%= booking.status %></td><td class="p-3 font-bold">Rp<%= new Intl.NumberFormat('id-ID').format(Number(booking.total_biaya)) %></td>
        </tr>
      <% }) %><% if (!daftar.length) { %><tr><td colspan="6" class="p-6 text-center">Belum ada pendapatan untuk filter ini.</td></tr><% } %></tbody>
    </table>
  </section>
  <% if (jumlahHalaman > 1) { %><nav class="mt-6 flex justify-end gap-2" aria-label="Halaman rincian rekap"><% if (halaman > 1) { %><a href="/admin/rekap?mulai=<%= encodeURIComponent(tanggalMulai) %>&selesai=<%= encodeURIComponent(tanggalSelesai) %>&lapangan=<%= lapanganId || '' %>&halaman=<%= halaman - 1 %>" class="border-2 border-tinta bg-kertas px-4 py-2 font-bold">Sebelumnya</a><% } %><span class="border-2 border-tinta bg-lime px-4 py-2 font-mono text-sm font-bold"><%= halaman %> / <%= jumlahHalaman %></span><% if (halaman < jumlahHalaman) { %><a href="/admin/rekap?mulai=<%= encodeURIComponent(tanggalMulai) %>&selesai=<%= encodeURIComponent(tanggalSelesai) %>&lapangan=<%= lapanganId || '' %>&halaman=<%= halaman + 1 %>" class="border-2 border-tinta bg-kertas px-4 py-2 font-bold">Berikutnya</a><% } %></nav><% } %>
</main>
<%- include('../partials/footer') %>
</body>
</html>
