<%- include('../partials/header', { judul }) %>
<%- include('../partials/navbar') %>
<main id="konten" class="mx-auto w-full max-w-7xl flex-1 px-6 py-10">
  <% if (pesanBaru) { %><p role="status" class="no-print mb-6 border-2 border-tinta bg-lime p-4 font-bold">Booking tersimpan dan menunggu pembayaran.</p><% } %>
  <% if (pesanDibayar) { %><p role="status" class="no-print mb-6 border-2 border-tinta bg-lime p-4 font-bold">Pembayaran berhasil dikonfirmasi. Status booking sekarang dibayar.</p><% } %>
  <% if (pesanStatus) { %><p role="alert" class="no-print mb-6 border-2 border-tinta bg-oranye p-4 font-bold"><%= pesanStatus %></p><% } %>
  <div class="mx-auto max-w-3xl">
  <div class="no-print mb-5 flex flex-wrap justify-between gap-3"><a href="<%= pengguna.role === 'penyewa' ? '/riwayat' : '/petugas/booking' %>" class="inline-flex min-h-11 items-center font-bold underline">← Kembali</a><div class="flex flex-wrap gap-3"><a href="/booking/<%= booking.id %>/bukti/pdf" class="inline-flex min-h-11 items-center border-2 border-tinta bg-kertas px-4 font-bold shadow-keras hover:bg-lime">Unduh PDF</a><button type="button" onclick="window.print()" class="tombol-utama">Cetak bukti <span aria-hidden="true" class="ml-2">↗</span></button></div></div>
    <article class="bukti-print border-2 border-tinta bg-kertas p-6 shadow-keras sm:p-10">
      <header class="flex flex-wrap items-start justify-between gap-4 border-b-2 border-tinta pb-6">
        <div><p class="font-mono text-xs font-bold uppercase tracking-widest">MAINYUK / BUKTI BOOKING</p><h1 class="mt-2 text-3xl font-black uppercase sm:text-4xl">Pemesanan lapangan</h1></div>
        <span class="border-2 border-tinta px-3 py-2 font-mono text-xs font-bold uppercase <%= booking.status === 'menunggu_pembayaran' ? 'bg-kuning' : (booking.status === 'dibatalkan' ? 'bg-oranye' : 'bg-lime') %>"><%= booking.status.replaceAll('_', ' ') %></span>
      </header>
      <div class="mt-6 bg-lime p-4"><p class="font-mono text-xs font-bold uppercase">KODE BOOKING</p><p class="mt-1 text-2xl font-black"><%= booking.kode_booking %></p></div>
      <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
        <div><dt class="font-mono text-[10px] font-bold uppercase text-neutral-600">Nama penyewa</dt><dd class="mt-1 text-lg font-bold"><%= booking.penyewa_nama %></dd></div>
        <div><dt class="font-mono text-[10px] font-bold uppercase text-neutral-600">Lapangan</dt><dd class="mt-1 text-lg font-bold"><%= booking.lapangan_nama %> / <%= booking.jenis_nama %></dd></div>
        <div><dt class="font-mono text-[10px] font-bold uppercase text-neutral-600">Tanggal</dt><dd class="mt-1 font-bold"><%= tanggalTampilan %></dd></div>
        <div><dt class="font-mono text-[10px] font-bold uppercase text-neutral-600">Waktu</dt><dd class="mt-1 font-bold"><%= String(booking.jam_mulai).slice(0, 5) %>—<%= String(booking.jam_selesai).slice(0, 5) %> / <%= booking.durasi_jam %> jam</dd></div>
        <div class="sm:col-span-2"><dt class="font-mono text-[10px] font-bold uppercase text-neutral-600">Total biaya</dt><dd class="mt-1 text-3xl font-black">Rp<%= totalTampilan %></dd></div>
      </dl>
      <p class="mt-8 border-t-2 border-dashed border-tinta pt-4 font-mono text-[10px] uppercase">Tunjukkan bukti ini saat datang ke lapangan.</p>
      <% if (pengguna.role === 'petugas' && booking.status === 'menunggu_pembayaran') { %>
        <form action="/petugas/booking/<%= booking.id %>/status" method="post" class="no-print mt-6 border-t-2 border-tinta pt-5">
          <input type="hidden" name="status" value="dibayar">
          <input type="hidden" name="kembali" value="bukti">
          <p class="mb-3 font-semibold">Pelanggan sudah membayar langsung? Konfirmasikan di sini.</p>
          <button class="tombol-utama">Konfirmasi pembayaran <span aria-hidden="true" class="ml-2">→</span></button>
        </form>
      <% } %>
    </article>
  </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
